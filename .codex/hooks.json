{
  "description": "CostLens: Claude hooks の共通処理を Codex のイベント形式で利用する。",
  "hooks": {
    "SessionStart": [{ "hooks": [{ "type": "command", "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/run.js\"", "timeout": 10, "statusMessage": "Loading CostLens session context" }] }],
    "PreToolUse": [{ "matcher": "Bash|apply_patch|Edit|Write|MultiEdit", "hooks": [{ "type": "command", "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/run.js\"", "timeout": 15, "statusMessage": "Checking repository guards" }] }],
    "PostToolUse": [{ "hooks": [{ "type": "command", "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/run.js\"", "timeout": 30, "statusMessage": "Checking edited files" }] }],
    "PostModelRequest": [{ "hooks": [{ "type": "command", "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/run.js\"", "timeout": 3 }] }],
    "PreCompact": [{ "hooks": [{ "type": "command", "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/run.js\"", "timeout": 10 }] }],
    "PostCompact": [{ "hooks": [{ "type": "command", "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/run.js\"", "timeout": 10 }] }],
    "SubagentStart": [{ "hooks": [{ "type": "command", "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/run.js\"", "timeout": 12 }] }],
    "SubagentStop": [{ "hooks": [{ "type": "command", "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/run.js\"", "timeout": 12 }] }],
    "Stop": [{ "hooks": [{ "type": "command", "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/run.js\"", "timeout": 60, "statusMessage": "Saving session and checking files" }] }],
    "SessionEnd": [{ "hooks": [{ "type": "command", "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/run.js\"", "timeout": 3 }] }],
    "PermissionRequest": [{ "hooks": [{ "type": "command", "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/run.js\"", "timeout": 10 }] }]
  }
}
